# match-odds environment template.
# Copy to `.env` (gitignored) and adjust. No secrets are required for local development.
# Every variable is read by the typed config in src/matchodds/config.py (prefix MATCHODDS_).

# Inference service (Epic 05).
# Host port that `make up` (docker compose) publishes; the container always listens on 8000.
# MATCHODDS_SERVE_PORT=8000
# Local `make serve` bind host and the environment label reported by GET /env.
# MATCHODDS_SERVE_HOST=127.0.0.1
# MATCHODDS_ENVIRONMENT=local

# Streamlit demo (Epic 06).
# Host port that `make up` publishes for the demo; the container always listens on 8501.
# MATCHODDS_DEMO_PORT=8501
# Base URL the demo POSTs fixtures to. `make demo` uses the default below; docker compose overrides
# it to http://serving:8000 (the demo never loads the model — it only calls the service).
# MATCHODDS_SERVICE_URL=http://127.0.0.1:8000
