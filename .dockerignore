# Keep the build context small and the image data-free + test-free.
.git
.github
.venv
venv

# Data is mounted at runtime, never baked into the image.
data/

# Not needed by either image. demo/ is COPYed by the demo image (so it is NOT excluded), but its
# tests are; the serving image never COPYs demo/, so it is unaffected by demo/ being in the context.
notebooks/
docs/
tests/
serving/tests/
demo/tests/

# Caches / build / coverage / local env.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
htmlcov/
.coverage
coverage.svg
.env

# Planning docs.
PLAN.md
MASTER_PLAN.md
